# Variaveis de ambiente — copie para .env (que NAO vai para o git) e preencha.
# Este arquivo e so o molde: nunca ponha valor real aqui.

# --- Observabilidade: rastro do Cronista no Langfuse -------------------
# Vazias = sem rastro e sem erro. O jogo roda igual; jogo.py:_liga_langfuse
# so instrumenta quando as duas chaves existem.
# LANGFUSE_HOST: deixe vazio para a nuvem padrao do SDK, ou aponte para a
# instancia local (ex.: http://localhost:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
