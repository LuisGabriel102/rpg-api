# Variaveis de ambiente — copie para .env (que NAO vai para o git) e preencha.
# Este arquivo e so o molde: nunca ponha valor real aqui.

# --- Observabilidade: rastro do Cronista no Langfuse -------------------
# Vazias = sem rastro e sem erro. O jogo roda igual; jogo.py:_liga_langfuse
# so instrumenta quando as duas chaves existem.
# LANGFUSE_HOST: deixe vazio para a nuvem padrao do SDK, ou aponte para a
# instancia local (ex.: http://localhost:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Banco: Postgres da Neon -------------------------------------------
# Usado pelo jogo e pelo infra/aws/backfill_embeddings.py. Ate agora o script
# de backfill dependia de --env-file apontando para o .env de OUTRO repo
# (nexus-monolito); ter a chave aqui desacopla os dois.
# A variavel de ambiente DATABASE_URL, se existir, GANHA deste arquivo.
DATABASE_URL=

# --- Aviso de fim de tarefa por WhatsApp (CallMeBot) -------------------
# Vazias = nenhum aviso e nenhum erro; o passo simplesmente e pulado.
# CALLMEBOT_PHONE: numero com codigo do pais, sem + e sem espaco (ex.: 5511...).
# CALLMEBOT_APIKEY: a chave que o proprio bot devolve no pareamento.
# Estas duas existem para que o aviso nunca precise ser buscado em lugar
# nao declarado — se nao estiverem aqui nem no ambiente, o aviso e pulado.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
